#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    /*
     * combos {
     *     compatible = "zmk,combos";
     *
     *     Escape {
     *         bindings = <&kp ESC>;
     *         key-positions = <0 11>;
     *     };
     *
     *     OpenParenthesis {
     *         bindings = <&kp LEFT_PARENTHESIS>;
     *         key-positions = <6 7>;
     *     };
     *
     *     OpenBrace {
     *         bindings = <&kp LEFT_BRACE>;
     *         key-positions = <18 19>;
     *     };
     *
     *     OpenBracket {
     *         bindings = <&kp LEFT_BRACKET>;
     *         key-positions = <30 31>;
     *     };
     *
     *     CloseParenthasis {
     *         bindings = <&kp RIGHT_PARENTHESIS>;
     *         key-positions = <8 7>;
     *     };
     *
     *     CloseBrace {
     *         bindings = <&kp RIGHT_BRACE>;
     *         key-positions = <19 20>;
     *     };
     *
     *     CloseBracket {
     *         bindings = <&kp RIGHT_BRACKET>;
     *         key-positions = <31 32>;
     *     };
     *
     *     LessThan {
     *         bindings = <&kp LESS_THAN>;
     *         key-positions = <3 4>;
     *     };
     *
     *     GreatherThan {
     *         bindings = <&kp GREATER_THAN>;
     *         key-positions = <4 5>;
     *     };
     *
     *     Enter {
     *         bindings = <&kp ENTER>;
     *         key-positions = <38 39>;
     *     };
     * };
     */

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  |  L3  |
            // | SHFT |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  | ;/: | ENTR |
            // | OPT  |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   | </, | >/. |  /? | ESC  |
            //                    | CMD | L2  | CTRL|   | L1  | SPC  |BSPC |

            bindings = <
&kp TAB         &kp Q  &kp W  &kp E     &kp R         &kp T          &kp Y      &kp U      &kp I          &kp O          &kp P          &mo 3
&kp LEFT_SHIFT  &kp A  &kp S  &kp D     &kp F         &kp G          &kp H      &kp J      &kp K          &kp L          &kp SEMI       &kp ENTER
&kp LEFT_ALT    &kp Z  &kp X  &kp C     &kp V         &kp B          &kp N      &kp M      &kp COMMA      &kp DOT        &kp FSLH       &kp ESC
                              &kp LGUI  &mo 2         &kp LCTRL      &mo 1      &kp SPACE  &kp BSPC
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // | TAB  |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  |      |
            // | SHFT |     |     | UP  |     |     |   |     |     |     |     |     |      |
            // | OPT  |     | LFT | DWN | RGT |     |   |     |     |     |     |     |      |
            //                    | CMD |     | CTRL|   |     | SPC |BSPC |

            bindings = <
&kp TAB          &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5    &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0  &mo 3
&kp LEFT_SHIFT   &trans        &trans        &kp UP        &trans        &trans          &trans        &trans        &trans        &trans        &trans        &trans
&kp LEFT_ALT     &trans        &kp LEFT      &kp DOWN      &kp RIGHT     &trans          &trans        &trans        &trans        &trans        &trans        &trans
                                             &kp LGUI      &trans        &kp LCTRL       &trans        &kp SPACE     &kp BSPC
            >;
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // | TAB  |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  |  L3  |
            // | SHFT |  `  |     |     |  -  |  [  |   |  ]  |  =  |  '  |  "  |  \  |      |
            // | OPT  |  ~  |     |     |  _  |  {  |   |  }  |  +  |     |     |  |  |      |
            //                    | CMD |     | CTRL|   |     | SPC |BSPC |

            bindings = <
&kp TAB             &kp EXCL   &kp AT      &kp HASH   &kp DLLR       &kp PRCNT      &kp CARET  &kp AMPS    &kp STAR   &kp LPAR  &kp RPAR  &trans
&kp LEFT_SHIFT      &kp GRAVE  &kp TILDE   &trans     &kp MINUS      &kp LBKT       &kp RBKT   &kp EQUAL   &kp SQT    &kp DQT   &kp BSLH  &trans
&kp LEFT_ALT        &trans     &trans      &trans     &kp UNDER      &kp LBRC       &kp RBRC   &kp PLUS    &kp DQT    &trans    &kp PIPE  &trans    
                               &kp LGUI    &trans     &kp LCTRL      &trans         &kp SPACE     &kp BSPC
            >;
        };

        media_layer {
            // -----------------------------------------------------------------------------------------
            // | SYSR | BT1 | BT2 | BT3 |     |     |   |     |     |     |     |     |  L3  |
            // | BOOT |PLAY |PREV |NEXT |MUTE |V_DWN|   |V_UP |     |     |     |     | SYSR |
            // |      |     |     |     |     |     |   |     |     |     |     |     | BOOT |
            //                    |     |     |     |   |     |     |     |

            bindings = <
&sys_reset   &bt BT_SEL 0      &bt BT_SEL 1      &bt BT_SEL 2     &trans             &trans             &trans           &trans  &trans  &trans  &bt BT_CLR  &mo 3
&bootloader  &kp C_PLAY_PAUSE  &kp C_PREV        &kp C_NEXT       &kp C_MUTE         &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &trans  &trans  &trans  &trans  &sys_reset
&trans       &trans            &trans            &trans           &trans             &trans             &trans           &trans  &trans  &trans  &trans  &bootloader
                               &trans            &trans           &trans             &trans             &trans           &trans
            >;
        };
    };
};


//For new Layers
    // -----------------------------------------------------------------------------------------
    // |      |     |     |     |     |     |   |     |     |     |     |     |      |
    // |      |     |     |     |     |     |   |     |     |     |     |     |      |
    // |      |     |     |     |     |     |   |     |     |     |     |     |      |
    //                    |     |     |     |   |     |     |     |
